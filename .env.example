# ============ App ============
APP_NAME=Psyber Voice
ENVIRONMENT=development          # production in real deployments
LOG_LEVEL=INFO
# Public HTTPS origin that Plivo can reach (webhooks + generated audio)
PUBLIC_BASE_URL=https://voice.example.com

# ============ Dashboard auth ============
ADMIN_USERNAME=admin
ADMIN_EMAIL=                     # sign-in email (the Admin profile page can set/change it)
ADMIN_PASSWORD=                  # required
SECRET_KEY=                      # python -c "import secrets;print(secrets.token_hex(32))" — same on every replica
API_TOKEN=                       # optional, for server-to-server calls

# ============ Infrastructure ============
DATABASE_URL=sqlite:///data/voiceagent.db     # postgresql+psycopg://user:pass@host:5432/voiceagent in production
REDIS_URL=                                     # required for >1 API instance, e.g. redis://redis:6379/0
POSTGRES_PASSWORD=                             # used by docker-compose
RUN_SCHEDULER=true
RUN_MIGRATIONS=true
WEB_CONCURRENCY=2

# ============ Telephony: Plivo ============
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=+918031803699
PLIVO_VALIDATE_SIGNATURE=true

# ============ LLM ============
LLM_PROVIDERS=sarvam,openrouter                # Sarvam streams the fastest Hindi replies
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nex-agi/nex-n2.5-mini:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TIMEOUT_SECONDS=4.5
SUMMARY_LLM_PROVIDERS=openrouter,sarvam         # post-call summaries: free models first, Sarvam fallback
TURN_END_GRACE_MS=50                           # wait after the caller stops before answering
TTS_ENGINE=sarvam                              # sarvam | indicf5 (local GPU, see app/services/indicf5.py)

# ============ Voice: Sarvam AI ============
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3

# ============ Voice pipeline ============
# stream: real-time Plivo audio stream + Sarvam streaming STT/TTS (~1.5-2s replies, barge-in)
# gather: legacy Plivo <GetInput> speech recognition (fallback)
VOICE_MODE=stream

# ============ Email (optional) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Email: Resend preferred (or SMTP_HOST/SMTP_FROM…)
RESEND_API_KEY=
EMAIL_FROM=Company <noreply@example.com>
EMAIL_REPLY_TO=

# Cost estimates on Analytics: rates from your invoices (leave 0 to show usage only)
COST_CURRENCY=₹
COST_PER_CALL_MINUTE=0
COST_PER_10K_TTS_CHARS=0
COST_PER_STT_HOUR=0
COST_PER_LLM_REQUEST=0
